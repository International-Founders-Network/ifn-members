# IFN Members — paste values in Netlify env (and local .env.local). Never commit real secrets.

# Clerk (Dashboard → API Keys). Create app "IFN Members" first.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Shared Neon (same project as landing). Prefer NETLIFY_DATABASE_URL for parity.
NETLIFY_DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
# DATABASE_URL=   # optional alias; app reads NETLIFY_DATABASE_URL first

# Stripe (same account as landing checkout). Portal only — no Checkout here.
STRIPE_SECRET_KEY=sk_live_REPLACE_or_sk_test
# Optional: STRIPE_CUSTOMER_PORTAL configuration id if you use a specific portal config
# STRIPE_PORTAL_CONFIGURATION_ID=

# App URL (portal return_url, absolute links)
NEXT_PUBLIC_APP_URL=https://members.ifn.community

# Pack A private storage (Cloudflare R2 S3-compatible). Without these, download API returns 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public base if you ever serve teasers publicly (not required for signed downloads)
# R2_PUBLIC_BASE=
# Teaser keys (parked): pack-a/teasers/<slug>.pdf. Flags live in Neon library_assets, toggled at /admin/library;
# landing reads them from GET /api/public/library (no env needed).

# Optional: next meetup placeholder link on Home
# NEXT_PUBLIC_NEXT_MEETUP_URL=https://lu.ma/...
